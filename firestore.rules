rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened global helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == '101proposal101@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Connectivity test probe
    match /test/{testId} {
      allow read: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'avatar', 'updatedAt', 'idVerification', 'currency', 'selectedCurrency', 'preferredCurrency', 'balances', 'countryCode', 'documentCountry', 'bio', 'businessName', 'serviceArea', 'workingHours', 'hourlyRate', 'location', 'walletStatus', 'walletBalance']))
      );
      allow delete: if isAdmin();
    }

    // Identity Verification Submissions for Wallet Unlocking
    match /verifications/{verificationId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(verificationId) && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Bookings and Dispatches
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && isValidId(bookingId) && incoming().customerId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.customerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'rating', 'updatedAt'])) ||
        (resource.data.providerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'providerCurrentLocation', 'updatedAt']))
      );
      allow delete: if isAdmin();
    }

    // Financial Ledger Transactions
    match /transactions/{txId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Complaints & Support Disputes
    match /complaints/{complaintId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(complaintId) && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
